[Unit]
Description=Unbazarbot Telegram voice transcription
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unbazarbot
WorkingDirectory=/opt/unbazarbot/current
EnvironmentFile=/etc/unbazarbot/bot.env
ExecStart=/opt/unbazarbot/current/.venv/bin/python /opt/unbazarbot/current/bot.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
